# ── Контент-API (headless MODX) ─────────────────────────────
# Базовый URL контент-API MODX (снип-эндпоинты: /flats, /flat, /floor, /contact,
# /<alias>). Слэш на конце НЕ нужен.
# НЕ ЗАДАН → используется ПРОДОВЫЙ адрес (https://www.klimashkina711.ru/api).
# Для локальной разработки укажи свой MODX явно, чтобы не ходить в прод.
API_BASE_URL=http://localhost:8080/api

# ── Источник каталога квартир ───────────────────────────────
# "api"  — живой CRM/MODX (/flats).
# "mock" — снимок в коде (src/lib/flats.mock.ts), без сетевых зависимостей:
#          удобно для локальной работы и превью.
# НЕ ЗАДАН → "api" (на Vercel-превью платформа сама ставит "mock").
APARTMENTS_SOURCE=api

# ── On-demand ревалидация (вебхук /api/revalidate) ──────────
# Секрет для вебхука MODX (событие OnDocFormSave). Передаётся ЗАГОЛОВКОМ:
#   x-revalidate-secret: <секрет>   (не в query — тот утекает в логи/Referer).
# Сгенерировать сильный секрет:
#   openssl rand -hex 32
# В проде приложение ОТКАЖЕТСЯ ревалидировать с пустым/плейсхолдерным значением.
REVALIDATE_SECRET=
